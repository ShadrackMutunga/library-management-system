{
  "info": {
    "name": "Library Management System API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"librarian@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"LIBRARIAN\"\n}"
            },
            "url": { "raw": "http://localhost:3000/auth/register", "host": ["localhost"], "port": "3000", "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"librarian@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "http://localhost:3000/auth/login", "host": ["localhost"], "port": "3000", "path": ["auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Genres",
      "item": [
        {
          "name": "Create Genre",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fantasy\"\n}"
            },
            "url": { "raw": "http://localhost:3000/genres", "host": ["localhost"], "port": "3000", "path": ["genres"] }
          }
        },
        {
          "name": "Get All Genres",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:3000/genres", "host": ["localhost"], "port": "3000", "path": ["genres"] }
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Create Book",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Hobbit\",\n  \"author\": \"J.R.R. Tolkien\",\n  \"isbn\": \"9780547928227\",\n  \"totalCopies\": 5,\n  \"genreId\": 1\n}"
            },
            "url": { "raw": "http://localhost:3000/books", "host": ["localhost"], "port": "3000", "path": ["books"] }
          }
        },
        {
          "name": "Get All Books",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:3000/books", "host": ["localhost"], "port": "3000", "path": ["books"] }
          }
        },
        {
          "name": "Search Books",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:3000/books?search=Tolkien&genreId=1&page=1&limit=10", "host": ["localhost"], "port": "3000", "path": ["books"], "query": [
              { "key": "search", "value": "Tolkien" },
              { "key": "genreId", "value": "1" },
              { "key": "page", "value": "1" },
              { "key": "limit", "value": "10" }
            ] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "http://localhost:3000/users/profile", "host": ["localhost"], "port": "3000", "path": ["users", "profile"] }
          }
        }
      ]
    }
  ]
}